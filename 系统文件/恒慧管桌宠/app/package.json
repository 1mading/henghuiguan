{
  "name": "henghuiguan-desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "恒慧管桌面挂件",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.henghuiguan.desktop-pet",
    "productName": "恒慧管桌宠",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer/**/*", "assets/**/*"],
    "win": {
      "target": ["portable"],
      "icon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
