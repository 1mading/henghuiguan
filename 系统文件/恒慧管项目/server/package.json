{
  "name": "henghuiguan-server",
  "version": "1.0.0",
  "description": "恒慧管 - 部门内部项目管控系统后端",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/db/seed.js",
    "migrate-mysql": "node scripts/migrate-json-to-mysql.js",
    "migrate-mysql-tables": "node scripts/migrate-app-store-to-tables.js",
    "setup-mysql-users": "node scripts/setup-mysql-users.js",
    "prepare-share-demo": "node scripts/prepare-share-demo.js",
    "simulate-intake": "node scripts/simulate-aitable-intake.js",
    "import-kpi-custom": "node scripts/import-kpi-custom-plans.js",
