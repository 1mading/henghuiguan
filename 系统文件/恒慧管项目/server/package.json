    "publish-release": "node scripts/publish-release.js",
    "ops-reminder": "node scripts/ops-reminder.js",
    "rotate-secrets": "node scripts/rotate-secrets.js",
    "build:web": "npm --prefix ../frontend run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.24.3",
    "uuid": "^11.0.5"
